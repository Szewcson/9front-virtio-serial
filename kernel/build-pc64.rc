#!/bin/rc
# SPDX-License-Identifier: MIT
# Build only; no install, boot changes, PCI configuration or reboot.
rfork e
if(! ~ $#* 0 1 2){ echo 'usage: rc kernel/build-pc64.rc [NEW-CONFIG-NAME [--checked-irq]]' >[1=2]; exit usage }
if(! test -r kernel/vconsole-boot-pc.c){ echo 'run from project root' >[1=2]; exit usage }
vc_checkout=`{pwd}
vc_conf=pc64qga
if(~ $#* 1 2) vc_conf=$1
vc_irqflags=()
if(~ $#* 2){
	if(! ~ $2 --checked-irq) exit usage
	vc_irqflags=-DVCONSOLE_CHECKED_IRQ
}
if(! @{echo $vc_conf | awk '{if(NF == 1 && $0 ~ /^[a-zA-Z][a-zA-Z0-9]*$/) ok=1} END{if(NR != 1 || !ok) exit 1}'}) exit name
vc_stage=/sys/src/9/pc64/vconsole-src-$pid
cd /sys/src/9/pc64 || exit source
if(test -e $vc_conf || test -e 9^$vc_conf){ echo 'configuration/output exists; use a new name' >[1=2]; exit exists }
cd $vc_checkout || exit source
rc scripts/export-upstream.rc $vc_stage || exit export
awk -f integration/config.awk integration/port.modules integration/pc.modules /sys/src/9/pc64/pc64 >/sys/src/9/pc64/$vc_conf || exit configuration
cd /sys/src/9/pc64 || exit source
mk -f $vc_checkout/kernel/pc64.mk 'CONF='^$vc_conf 'VCSOURCE='^$vc_stage 'VCPORT='^$vc_stage^'/sys/src/9/port' 'VCPC='^$vc_stage^'/sys/src/9/pc' 'VCIRQFLAGS='^$vc_irqflags 9^$vc_conf || exit build
echo 'built:' /sys/src/9/pc64/9^$vc_conf
echo 'stock configuration, images and boot files were not replaced'
exit ''
