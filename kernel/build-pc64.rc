#!/bin/rc
# SPDX-License-Identifier: MIT
# Build only. Does NOT install, change boot files, configure PCI, or reboot.
# Run from the project checkout, native PC64 sources/toolchain required.
rfork e
if(! test -r kernel/vconsole-boot-pc.c){ echo 'run from project root' >[1=2]; exit usage }
qgasrc=`{pwd}
cd /sys/src/9/pc64 || exit source
# Dedicated config/output and staging directory; never replace pc64/9pc64.
mkdir -p qga9kern
cp $qgasrc/kernel/*.c $qgasrc/kernel/*.h qga9kern/ || exit copy
for(i in vconsole vconsole-mmio vconsole-dma vconsole-irq vconsole-pump vconsole-stream vconsole-controller vconsole-worker vconsole-io){
	{echo '#include <u.h>'
	 echo '#include "/sys/src/9/port/lib.h"'
	 echo '#define QGA_VCONSOLE_KERNEL'
	 echo '#include "'^$i^'.c"'} >qga9kern/$i-kernel.c
}
awk '/^dev$/ {print; print "\tvconsole"; next}
 /^misc$/ {print; n=split("vconsole vconsole-mmio vconsole-dma vconsole-irq vconsole-pump vconsole-stream vconsole-controller vconsole-worker vconsole-io vconsole-pc vconsole-wake vconsole-controller-pc vconsole-worker-pc vconsole-owner-pc vconsole-io-pc vconsole-boot-pc", modules, " "); for(i=1; i<=n; i++) print "\t" modules[i]; next}
 {print}' pc64 >pc64qga
mk -f $qgasrc/kernel/pc64.mk 'CONF=pc64qga' 9pc64qga
